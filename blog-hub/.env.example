# ---------------------------------------------------------------------------
# Blog Hub environment variables. Copy to `.env.local` and fill in.
# ---------------------------------------------------------------------------

# Supabase — from your project's Settings → API page
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The service role key is SECRET (server-only). It bypasses Row Level Security,
# so it is used only in server code (API routes) — never shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (Claude) — powers AI draft generation
ANTHROPIC_API_KEY=sk-ant-...

# Admin gate. ADMIN_PASSWORD is what you type on the login screen.
# ADMIN_SESSION_TOKEN is any long random string — it is the value stored in the
# session cookie once you log in. Generate one with:  openssl rand -hex 32
ADMIN_PASSWORD=change-me
ADMIN_SESSION_TOKEN=generate-a-long-random-string
